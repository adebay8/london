generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGO_URI")
}

model Neighbourhood {
  id        String   @id @default(cuid()) @map("_id")
  name      String
  borough   String
  zone      Int
  postcodes String
  status    String?
  updatedAt DateTime @default(now()) @updatedAt

  researchProfile    ResearchProfile?
  researchJobs       ResearchJob[]
  journalEntries     JournalEntry[]
  apartmentBuildings ApartmentBuilding[]
  ranking            Ranking?

  @@unique([name, borough])
  @@map("neighbourhoods")
}

model ResearchProfile {
  id              String   @id @default(cuid()) @map("_id")
  neighbourhoodId String   @unique
  overview        String
  safety          String   // JSON string
  transport       String   // JSON string
  rentValue       String   // JSON string
  newBuilds       String   // JSON string
  amenities       String   // JSON string
  areaQuality     String   // JSON string
  pros            String   // JSON string (array)
  cons            String   // JSON string (array)
  fitScore        Float
  rawResponse     String
  researchedAt    DateTime @default(now())
  modelUsed       String

  neighbourhood Neighbourhood @relation(fields: [neighbourhoodId], references: [id])

  @@map("research_profiles")
}

model ResearchJob {
  id              String    @id @default(cuid()) @map("_id")
  neighbourhoodId String
  status          String    @default("pending")
  startedAt       DateTime?
  completedAt     DateTime?
  error           String?

  neighbourhood Neighbourhood @relation(fields: [neighbourhoodId], references: [id])

  @@map("research_jobs")
}

model JournalEntry {
  id               String   @id @default(cuid()) @map("_id")
  neighbourhoodId  String?
  content          String
  decision         String?
  fitScoreSnapshot Float?
  createdAt        DateTime @default(now())

  neighbourhood Neighbourhood? @relation(fields: [neighbourhoodId], references: [id])

  @@map("journal_entries")
}

model ApartmentBuilding {
  id              String   @id @default(cuid()) @map("_id")
  neighbourhoodId String
  placeId         String   @unique
  name            String
  address         String
  lat             Float
  lng             Float
  googleMapsUri   String
  types           String   // JSON string[]
  fetchedAt       DateTime @default(now())

  neighbourhood Neighbourhood     @relation(fields: [neighbourhoodId], references: [id])
  amenities     BuildingAmenity[]

  @@index([neighbourhoodId])
  @@map("apartment_buildings")
}

model BuildingAmenity {
  id            String   @id @default(cuid()) @map("_id")
  buildingId    String
  category      String
  name          String
  address       String
  lat           Float
  lng           Float
  placeId       String
  googleMapsUri String
  walkMins      Float
  walkMeters    Int
  fetchedAt     DateTime @default(now())

  building ApartmentBuilding @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@index([buildingId])
  @@unique([buildingId, placeId])
  @@map("building_amenities")
}

model Ranking {
  id              String @id @default(cuid()) @map("_id")
  neighbourhoodId String @unique
  position        Int

  neighbourhood Neighbourhood @relation(fields: [neighbourhoodId], references: [id])

  @@map("rankings")
}

model Setting {
  key   String @id @map("_id")
  value String

  @@map("settings")
}

// ---------------------------------------------------------------------------
// Flat-search (beaufort-flats skill). Sole source of truth for the multi-area
// rental search. Dates are ISO strings ("YYYY-MM-DD") so view-logic semantics
// match. Global config lives in `settings` under keys flat.*.
// ---------------------------------------------------------------------------

model FlatArea {
  id              String @id @map("_id") // e.g. "wembley-park"
  name            String
  borough         String
  zone            String
  tier            String // "anchor" | "1" | "2"
  expectedBand    String?
  sortOrder       Int    @default(0)
  buildingRoster  String @default("[]") // JSON string[]
  phaseYears      String @default("{}") // JSON { building: year }
  btrOperators    String @default("[]") // JSON string[]
  operatorPortals String @default("[]") // JSON string[]
  searchUrls      String @default("{}") // JSON { zoopla, rightmove }
  flags           String @default("[]") // JSON string[]

  listings FlatListing[]

  @@map("flat_areas")
}

model FlatListing {
  id               String  @id @map("_id") // stable kebab id: area-building-price
  areaId           String
  building         String
  street           String?
  phaseYear        Int?
  phaseLabel       String?
  price            Int
  budgetTier       String // "in" | "btr" | "over"
  furnishing       String  @default("furnished") // "furnished" | "unfurnished" | "either"
  available        String?
  availableNow     Boolean @default(false)
  availableDate    String? // ISO date or null
  listedDate       String? // ISO date or null
  epc              String?
  sizeSqft         Int?
  scheme           String // "btr" | "private" | "unknown"
  operator         String?
  schemeConfidence String  @default("unverified")
  schemeSource     String?
  firstSeen        String // ISO date
  lastSeen         String // ISO date
  lastConfirmed    String? // ISO date
  status           String  @default("active") // "active" | "gone"
  goneReason       String? // "removed" | "let-agreed"
  unconfirmed      Boolean @default(false)
  isNew            Boolean @default(false)
  imageUrl         String?
  note             String?

  area    FlatArea            @relation(fields: [areaId], references: [id], onDelete: Cascade)
  sources FlatListingSource[]
  pref    FlatPref?

  @@index([areaId])
  @@map("flat_listings")
}

model FlatListingSource {
  id        String  @id @default(cuid()) @map("_id")
  listingId String
  platform  String
  url       String
  agent     String?

  listing FlatListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, url])
  @@index([listingId])
  @@map("flat_listing_sources")
}

model FlatPref {
  id        String   @id @default(cuid()) @map("_id")
  listingId String   @unique
  pref      String // "want" | "reject"
  updatedAt DateTime @default(now()) @updatedAt

  listing FlatListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("flat_prefs")
}
