generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGO_URI")
}

model Neighbourhood {
  id        String   @id @default(cuid()) @map("_id")
  name      String
  borough   String
  zone      Int
  postcodes String
  status    String?
  updatedAt DateTime @default(now()) @updatedAt

  researchProfile    ResearchProfile?
  researchJobs       ResearchJob[]
  journalEntries     JournalEntry[]
  apartmentBuildings ApartmentBuilding[]
  ranking            Ranking?

  @@unique([name, borough])
  @@map("neighbourhoods")
}

model ResearchProfile {
  id              String   @id @default(cuid()) @map("_id")
  neighbourhoodId String   @unique
  overview        String
  safety          String   // JSON string
  transport       String   // JSON string
  rentValue       String   // JSON string
  newBuilds       String   // JSON string
  amenities       String   // JSON string
  areaQuality     String   // JSON string
  pros            String   // JSON string (array)
  cons            String   // JSON string (array)
  fitScore        Float
  rawResponse     String
  researchedAt    DateTime @default(now())
  modelUsed       String

  neighbourhood Neighbourhood @relation(fields: [neighbourhoodId], references: [id])

  @@map("research_profiles")
}

model ResearchJob {
  id              String    @id @default(cuid()) @map("_id")
  neighbourhoodId String
  status          String    @default("pending")
  startedAt       DateTime?
  completedAt     DateTime?
  error           String?

  neighbourhood Neighbourhood @relation(fields: [neighbourhoodId], references: [id])

  @@map("research_jobs")
}

model JournalEntry {
  id               String   @id @default(cuid()) @map("_id")
  neighbourhoodId  String?
  content          String
  decision         String?
  fitScoreSnapshot Float?
  createdAt        DateTime @default(now())

  neighbourhood Neighbourhood? @relation(fields: [neighbourhoodId], references: [id])

  @@map("journal_entries")
}

model ApartmentBuilding {
  id              String   @id @default(cuid()) @map("_id")
  neighbourhoodId String
  placeId         String   @unique
  name            String
  address         String
  lat             Float
  lng             Float
  googleMapsUri   String
  types           String   // JSON string[]
  fetchedAt       DateTime @default(now())

  neighbourhood Neighbourhood     @relation(fields: [neighbourhoodId], references: [id])
  amenities     BuildingAmenity[]

  @@index([neighbourhoodId])
  @@map("apartment_buildings")
}

model BuildingAmenity {
  id            String   @id @default(cuid()) @map("_id")
  buildingId    String
  category      String
  name          String
  address       String
  lat           Float
  lng           Float
  placeId       String
  googleMapsUri String
  walkMins      Float
  walkMeters    Int
  fetchedAt     DateTime @default(now())

  building ApartmentBuilding @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@index([buildingId])
  @@unique([buildingId, placeId])
  @@map("building_amenities")
}

model Ranking {
  id              String @id @default(cuid()) @map("_id")
  neighbourhoodId String @unique
  position        Int

  neighbourhood Neighbourhood @relation(fields: [neighbourhoodId], references: [id])

  @@map("rankings")
}

model Setting {
  key   String @id @map("_id")
  value String

  @@map("settings")
}

// ---------------------------------------------------------------------------
// Flat-search (beaufort-flats skill). Sole source of truth for the multi-area
// rental search. Dates are ISO strings ("YYYY-MM-DD") so view-logic semantics
// match. Global config lives in `settings` under keys flat.*.
// ---------------------------------------------------------------------------

model FlatArea {
  id              String @id @map("_id") // e.g. "wembley-park"
  name            String
  borough         String
  zone            String
  tier            String // "anchor" | "1" | "2"
  expectedBand    String?
  sortOrder       Int    @default(0)
  buildingRoster  String @default("[]") // JSON string[]
  phaseYears      String @default("{}") // JSON { building: year }
  btrOperators    String @default("[]") // JSON string[]
  operatorPortals String @default("[]") // JSON string[]
  searchUrls      String @default("{}") // JSON { zoopla, rightmove }
  flags           String @default("[]") // JSON string[]

  listings FlatListing[]

  @@map("flat_areas")
}

model FlatListing {
  id               String  @id @map("_id") // stable kebab id: area-building-price
  areaId           String
  building         String
  street           String?
  phaseYear        Int?
  phaseLabel       String?
  price            Int
  budgetTier       String // "in" | "btr" | "over"
  furnishing       String  @default("furnished") // "furnished" | "unfurnished" | "either"
  available        String?
  availableNow     Boolean @default(false)
  availableDate    String? // ISO date or null
  listedDate       String? // ISO date or null
  epc              String?
  sizeSqft         Int?
  scheme           String // "btr" | "private" | "unknown"
  operator         String?
  schemeConfidence String  @default("unverified")
  schemeSource     String?
  firstSeen        String // ISO date
  lastSeen         String // ISO date
  lastConfirmed    String? // ISO date
  status           String  @default("active") // "active" | "gone"
  goneReason       String? // "removed" | "let-agreed"
  unconfirmed      Boolean @default(false)
  isNew            Boolean @default(false)
  imageUrl         String?
  note             String?

  area    FlatArea            @relation(fields: [areaId], references: [id], onDelete: Cascade)
  sources FlatListingSource[]
  pref    FlatPref?

  @@index([areaId])
  @@map("flat_listings")
}

model FlatListingSource {
  id        String  @id @default(cuid()) @map("_id")
  listingId String
  platform  String
  url       String
  agent     String?

  listing FlatListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, url])
  @@index([listingId])
  @@map("flat_listing_sources")
}

model FlatPref {
  id        String   @id @default(cuid()) @map("_id")
  listingId String   @unique
  pref      String // "want" | "reject"
  updatedAt DateTime @default(now()) @updatedAt

  listing FlatListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("flat_prefs")
}

// ---------------------------------------------------------------------------
// Bed search. One row per MODEL (not per colourway) of 4FT6 double ottoman bed
// frame. Raw data only — the recommendation score, landed-cost banding and
// "clears a hard-shell suitcase" test are all recomputed live in lib/beds/score.ts
// so the ranking can be retuned without re-importing. Populated by
// scripts/beds-import.ts from the research CSV.
// ---------------------------------------------------------------------------

model Bed {
  id                  String  @id @map("_id") // kebab: retailer-model
  retailer            String
  brand               String
  model               String
  productUrl          String
  colourwayShown      String?
  colourwaysAvailable String?

  // Money. landedCost = item + delivery + assembly, and is the only comparable
  // figure across retailers (Costco bundles white-glove assembly; most don't).
  doublePriceGbp      Float
  deliveryCostGbp     Float? // null when bundled into the item price
  deliveryIncluded    Boolean @default(false)
  assemblyCostGbp     Float?
  assemblyIncluded    Boolean @default(false)
  landedCostGbp       Float
  extraMembershipCost String? // Costco: membership is a hard gate, not a surcharge
  overBudget          Boolean @default(false)

  // "included" = built in your room at the landed price | "paid" = a real priced
  // service exists | "self" = flat-pack, you build it
  arrivesAssembled String @default("self")

  // The ranked buying criteria (see docs/beds-criteria.md)
  openingDirection    String? // "end" | "side" | "either"
  liftMechanism       String?
  gasStrutRating      String? // free text, e.g. "4 x 800N"
  strutCount          Int?
  frameMaterial       String?
  fixingType          String?
  storageDepthCm      Float?
  ottomanType         String  @default("full") // "full" | "half" | "side-only"
  maxMattressWeightKg Float?
  minMattressWeightKg Float?
  baseType            String?
  slatGapCm           Float?

  // Footprint — overhang is width beyond the 135cm mattress, which is what
  // actually costs floor space in a small bedroom.
  overallWidthCm  Float?
  overallLengthCm Float?
  overallHeightCm Float?
  overhangCm      Float?
  longestBoxCm    Float? // the London-staircase filter

  upholsteryMaterial String?
  headboardStyle     String?

  warranty                String?
  warrantyCoversMechanism String?
  sparePartsAvailable     String?
  returnsWindow           String?
  deliveryLeadTime        String?
  reviewScore             Float?
  reviewCount             Int?

  /// Merchandising image from the retailer's product data. Nullable: not every
  /// retailer exposes one, and a missing photo must never affect ranking.
  imageUrl                String?

  // Consumer finance — a RETAILER-level policy applied to every one of that
  // retailer's rows at import, and deliberately excluded from the
  // recommendation score (it changes how you pay, not how good the bed is).
  // Stored as ONE JSON column rather than ~10 scalars because Prisma compiles
  // MongoDB writes into an aggregation pipeline of roughly one stage per
  // field, and Atlas rejects pipelines over 50 stages. Same reason `extra`
  // is a JSON string. Shape: lib/beds/types.ts FinancePolicy.
  finance String @default("{}")

  notes String?
  extra String @default("{}") // JSON: the long-tail columns, shown in the detail drawer

  pref BedPref?

  @@index([retailer])
  @@map("beds")
}

model BedPref {
  id        String   @id @default(cuid()) @map("_id")
  bedId     String   @unique
  pref      String // "want" | "reject"
  updatedAt DateTime @default(now()) @updatedAt

  bed Bed @relation(fields: [bedId], references: [id], onDelete: Cascade)

  @@map("bed_prefs")
}

// ---------------------------------------------------------------------------
// TV console search. One row per MODEL of floor-standing TV unit sized to take
// a 55" LG OLED55B56LA on its stand, an LG S80TR soundbar in front of it, and
// a PS5 Slim lying flat. Raw data only — the fit verdict, the recommendation
// score and the landed-cost banding are all recomputed live in
// lib/consoles/{fit,score}.ts so the ranking can be retuned without
// re-importing. Populated by scripts/consoles-import.ts from the research CSV.
//
// Named TvConsole rather than Console to match the TS interface, which avoids
// shadowing the global DOM `Console` type.
// ---------------------------------------------------------------------------

model TvConsole {
  id                  String  @id @map("_id") // kebab: retailer-model
  retailer            String
  brand               String
  model               String
  productUrl          String
  colourwayShown      String?
  colourwaysAvailable String?

  // Money. landedCost = item + delivery + assembly, and is the only comparable
  // figure across retailers.
  priceGbp         Float
  deliveryCostGbp  Float? // null when bundled into the item price
  deliveryIncluded Boolean @default(false)
  assemblyCostGbp  Float?
  assemblyIncluded Boolean @default(false)
  landedCostGbp    Float
  overBudget       Boolean @default(false)

  // "included" = built in your room at the landed price | "paid" = a real
  // priced service exists | "self" = flat-pack, you build it
  arrivesAssembled String @default("self")

  // Always floor-standing in this corpus, but recorded so a stray wall-mounted
  // row is filtered rather than silently scored.
  mounting String?

  // The top surface — where the TV and soundbar have to coexist. Depth is the
  // binding constraint: 23.5cm of TV base plus 13.5cm of soundbar, in line.
  topWidthCm Float?
  topDepthCm Float?
  topLoadKg  Float?

  overallWidthCm  Float?
  overallDepthCm  Float?
  overallHeightCm Float?

  // Compartments, as ONE JSON column rather than ~15 scalars. Two reasons:
  // a console has N bays of differing sizes where a bed had none, and Prisma
  // compiles MongoDB writes into an aggregation pipeline of roughly one stage
  // per field which Atlas rejects past 50 stages. Shape: lib/consoles/types.ts
  // Bay[]. A null dimension means UNPUBLISHED, never zero.
  bays String @default("[]")

  backPanel       String? // "open" | "ported" | "solid"
  cableManagement String?

  frameMaterial  String?
  finishMaterial String?
  legStyle       String?

  warranty            String?
  sparePartsAvailable String?
  returnsWindow       String?
  deliveryLeadTime    String?
  reviewScore         Float?
  reviewCount         Int?

  /// Merchandising image from the retailer's product data. Nullable: not every
  /// retailer exposes one, and a missing photo must never affect ranking.
  imageUrl            String?

  // Retailer-level finance policy, stamped onto every one of that retailer's
  // rows at import and deliberately excluded from the recommendation score.
  // Shape: lib/retail/finance.ts FinancePolicy.
  finance String @default("{}")

  notes String?
  extra String @default("{}") // JSON: the long-tail columns, shown in the drawer

  pref ConsolePref?

  @@index([retailer])
  @@map("tv_consoles")
}

model ConsolePref {
  id        String   @id @default(cuid()) @map("_id")
  consoleId String   @unique
  pref      String // "want" | "reject"
  updatedAt DateTime @default(now()) @updatedAt

  console TvConsole @relation(fields: [consoleId], references: [id], onDelete: Cascade)

  @@map("console_prefs")
}
